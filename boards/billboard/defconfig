# Billboard badge: PebbleOS as Flint, on ESP-IDF

CONFIG_SOC_POSIX=y
CONFIG_POSIX_ESPIDF=y

CONFIG_PLATFORM_FLINT=y

CONFIG_LIBC_HOST=y

CONFIG_UART=y

CONFIG_DISPLAY=y
CONFIG_DISPLAY_SDL_WIDTH=144
CONFIG_DISPLAY_SDL_HEIGHT=168
CONFIG_DISPLAY_SDL_MONO=y

CONFIG_FLASH=y

CONFIG_OTP=y

CONFIG_BATTERY=y

CONFIG_VIBE=y

CONFIG_AMBIENT_LIGHT=y

CONFIG_BACKLIGHT=y

CONFIG_RTC=y

CONFIG_RNG=y

CONFIG_TEMPERATURE=y

CONFIG_LOG_HASHED=n

CONFIG_ACCEL=y
CONFIG_ACCEL_POSIX=y

# Silent, as on native_flint: the reminders app needs the voice window.
CONFIG_MIC=y

CONFIG_SERVICE_ACCEL_MANAGER_DEFAULT_SENSITIVITY=85
CONFIG_BT_VENDOR_NAME="Billboard"

# The ESP32-S3's own BLE controller, reached over ESP-IDF's VHCI as an H4
# "UART" (soc/posix/espidf/app/main/bt_bottom.c), with its factory address.
CONFIG_BT_HCI_UART=y
CONFIG_BT_ID_ADDR_CONTROLLER=y
