CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MiB octal PSRAM. The firmware's zeroed data (its heaps, app RAM) lives
# there; see main/pebbleos.lf.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# The console is the chip's own USB port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Kernel threads are pthreads; their stacks stay in internal RAM, so that
# they may call into the flash driver.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Firmware threads may keep a core busy; don't reset over a starved idle task.
CONFIG_ESP_TASK_WDT_INIT=n

# The firmware library has to agree with this (soc/posix/espidf/include/sdkconfig.h).
CONFIG_LIBC_NEWLIB=y
